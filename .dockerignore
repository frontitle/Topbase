# The runtime image only uses the source and notices listed here.
**
!go.mod
!go.sum

# Keep a literal prefix for each Go package so Docker can traverse it.
# Add new package directories alongside these entries.
!cmd/topbase/*.go
!cmd/topbase-backup/*.go
!cmd/topbase-cli/*.go
!cmd/topbase-mcp/*.go
!internal/*.go
!internal/adapters/*.go
!internal/adapters/appdb/*.go
!internal/adapters/feishu/*.go
!internal/adapters/webhook/*.go
!internal/aimcp/*.go
!internal/app/content/*.go
!internal/app/identity/*.go
!internal/app/notify/*.go
!internal/app/query/*.go
!internal/app/viz/*.go
!internal/app/warehouse/*.go
!internal/backup/*.go
!internal/buildinfo/*.go
!internal/core/*.go
!internal/core/queryir/*.go
!internal/platform/httpapi/*.go
!internal/topbaseapi/*.go
!migrations/*.go
!internal/adapters/appdb/schema.sql
!migrations/*.sql

# Browser bundles and views embedded by the HTTP server. The entry files
# keep their directory trees traversable by the classic Docker context packer.
!internal/platform/httpapi/web/**/*.html
!internal/platform/httpapi/web/**/*.js
!internal/platform/httpapi/web/**/*.css
!internal/platform/httpapi/web/account/index.html
!internal/platform/httpapi/web/admin/datamodel/index.html
!internal/platform/httpapi/web/admin/embedding/index.html
!internal/platform/httpapi/web/admin/integrations/index.html
!internal/platform/httpapi/web/admin/monitor/index.html
!internal/platform/httpapi/web/admin/people/index.html
!internal/platform/httpapi/web/admin/permissions/index.html
!internal/platform/httpapi/web/admin/settings/index.html
!internal/platform/httpapi/web/admin/updates/index.html
!internal/platform/httpapi/web/auth/login/index.html
!internal/platform/httpapi/web/browse/models/index.html
!internal/platform/httpapi/web/collections/view/index.html
!internal/platform/httpapi/web/components/code/*.js
!internal/platform/httpapi/web/components/query-editor/*.js
!internal/platform/httpapi/web/dashboard/view/index.html
!internal/platform/httpapi/web/data/index.html
!internal/platform/httpapi/web/developers/dashboard-components/example/index.html
!internal/platform/httpapi/web/embed/*.js
!internal/platform/httpapi/web/locales/*.js
!internal/platform/httpapi/web/questions/new/index.html
!internal/platform/httpapi/web/questions/view/index.html
!internal/platform/httpapi/web/search/index.html
!internal/platform/httpapi/web/setup/index.html
!internal/platform/httpapi/web/trash/index.html
!internal/platform/httpapi/web/warehouse/index.html
!internal/platform/httpapi/web/assets/topbase-logo.png
!internal/platform/httpapi/web/assets/maps/china-provinces.json
!internal/platform/httpapi/web/assets/maps/NOTICE.md
!internal/platform/httpapi/web/vendor/lucide-nav.svg
!internal/platform/httpapi/web/vendor/lucide-LICENSE.txt

# Distribution license texts
!deploy/collect-go-notices.sh
!LICENSE
!NOTICE
!licenses/echarts/LICENSE
!licenses/echarts/NOTICE
!licenses/echarts/licenses/LICENSE-d3
!licenses/echarts/licenses/tslib-CopyrightNotice.txt
!licenses/echarts/licenses/tslib-LICENSE.txt
!licenses/echarts/licenses/zrender-LICENSE
!licenses/geojson-chinadata/LICENSE

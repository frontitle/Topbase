# Direct source/binary deployment listens on port 80 by default. TOPBASE_ADDR
# accepts an address such as :9000; TOPBASE_PORT accepts a port number instead.
TOPBASE_ADDR=:80
TOPBASE_PORT=

# Docker keeps the non-root container on 8080 and publishes this host port.
TOPBASE_HTTP_PORT=8101

# Optional direct TLS. Configure both files together. A reverse proxy or cloud
# load balancer can terminate TLS instead and leave these values empty.
TOPBASE_TLS_CERT_FILE=
TOPBASE_TLS_KEY_FILE=

# Persistent application state. Never commit the contents of this directory.
TOPBASE_DATA_DIR=./data

# Shared Topbase application database. The default docker-compose.yml starts a
# private PostgreSQL container; docker-compose.rds.yml uses the same variables
# with an Alibaba Cloud or Tencent Cloud RDS endpoint.
TOPBASE_APP_DB_ENGINE=postgres
TOPBASE_APP_DB_HOST=appdb
TOPBASE_APP_DB_PORT=5432
TOPBASE_APP_DB_NAME=topbase
TOPBASE_APP_DB_SCHEMA=public
TOPBASE_APP_DB_USER=topbase
TOPBASE_APP_DB_PASSWORD=
# Only required by docker-compose.mysql.yml.
TOPBASE_MYSQL_ROOT_PASSWORD=
TOPBASE_APP_DB_TLS_MODE=disable
TOPBASE_APP_DB_CA_FILE=
TOPBASE_APP_DB_MAX_OPEN_CONNS=20
TOPBASE_APP_DB_MAX_IDLE_CONNS=5

# Generate once with: openssl rand -base64 32
# Keep this value unchanged across upgrades and identical on every app node.
TOPBASE_MASTER_KEY=
TOPBASE_INSTANCE_ID=topbase-1

# Set to off only for local debugging or tests.
TOPBASE_CRON=on

# Set to true when Topbase is served through HTTPS in production.
TOPBASE_SECURE_COOKIES=false

# Optional release metadata used by Docker builds and /api/version.
TOPBASE_VERSION=0.2.3
TOPBASE_COMMIT=unknown
TOPBASE_BUILD_TIME=unknown

# Optional Feishu integrations.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_WEBHOOK_URL=

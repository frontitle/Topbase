[Unit]
Description=Topbase analytics platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=topbase
Group=topbase
WorkingDirectory=/opt/topbase
EnvironmentFile=/etc/topbase/topbase.env
ExecStart=/opt/topbase/topbase
Restart=on-failure
RestartSec=5s
TimeoutStopSec=40s
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/topbase /var/backups/topbase

[Install]
WantedBy=multi-user.target
